APP_NAME=BarberControl
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barbercontrol
DB_USERNAME=root
DB_PASSWORD=

ADMIN_NAME="Administrador BarberControl"
ADMIN_EMAIL=admin@barbercontrol.local
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Cambiar a true cuando el sitio funcione exclusivamente con HTTPS.
SESSION_SECURE_COOKIE=false

# Seguridad de producción
SECURITY_FORCE_HTTPS=false
# IPs del proxy inverso separadas por coma; no usar * sin controlar la red.
SECURITY_TRUSTED_PROXIES=
TWO_FACTOR_ENABLED=true
TWO_FACTOR_ISSUER="${APP_NAME}"
TWO_FACTOR_WINDOW=1
ERROR_MONITORING_ENABLED=true
ERROR_RETENTION_DAYS=90

# Respaldos privados cifrados. Puede definir una clave base64 distinta de APP_KEY.
BACKUP_ENABLED=true
BACKUP_DISK=local
BACKUP_DIRECTORY=backups/database
BACKUP_RETENTION_DAYS=30
BACKUP_RUN_AT=02:00
BACKUP_ENCRYPTION_KEY="${APP_KEY}"
# En Windows indique las rutas completas si MySQL no está en PATH.
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_MYSQL_PATH=mysql

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Business Platform: usa "log" en local y "meta" en producción.
WHATSAPP_DRIVER=log
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DEFAULT_COUNTRY_CODE=52
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
WHATSAPP_TICKET_URL_MINUTES=60
WHATSAPP_TEMPLATE_CONFIRMATION=barbercontrol_confirmacion_cita
WHATSAPP_TEMPLATE_REMINDER_24H=barbercontrol_recordatorio_24h
WHATSAPP_TEMPLATE_REMINDER_2H=barbercontrol_recordatorio_2h
WHATSAPP_TEMPLATE_CANCELLATION=barbercontrol_cancelacion_cita
WHATSAPP_TEMPLATE_RESCHEDULED=barbercontrol_reprogramacion_cita
WHATSAPP_TEMPLATE_TICKET=barbercontrol_ticket
